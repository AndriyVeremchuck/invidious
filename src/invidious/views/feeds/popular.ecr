<%
    clean_popular = popular_videos.reject do |v|
      if v.is_a?(SearchVideo)
        v.live_now || v.upcoming? || (v.premiere_timestamp.try &.> Time.utc)
      else
        true
      end
    end

    feed_items = if clean_popular.empty?
      begin
        res, _ = Invidious::Feeds::Trending.fetch("Default", env.get("preferences").as(Preferences).region, locale)
        res
      rescue
        [] of SearchVideo
      end
    else
      clean_popular
    end

    query_v = env.params.query["v"]?
    query_q = env.params.query["q"]?

    initial_item = if query_v && !query_v.empty?
      feed_items.find { |i| i.id == query_v }
    else
      nil
    end
    initial_item ||= feed_items.first?

    initial_id = (query_v && !query_v.empty?) ? query_v : (initial_item && initial_item.responds_to?(:id) ? initial_item.id : "")
    initial_title = initial_item && initial_item.responds_to?(:title) ? initial_item.title : ""
    autoplay_param = "0"
%>

<% content_for "header" do %>
<meta name="description" content="<%= I18n.translate(locale, "An alternative front-end to YouTube") %>">
<title>
    <% if !initial_title.empty? %>
        <%= HTML.escape(initial_title) %> - Invidious
    <% elsif env.get("preferences").as(Preferences).default_home != "Popular" %>
        <%= I18n.translate(locale, "Popular") %> - Invidious
    <% else %>
        Invidious
    <% end %>
</title>
<% end %>

<div class="edge-to-edge-app">
    <!-- 1. FULLSCREEN VIDEO PLAYER (EDGE TO EDGE) -->
    <div class="edge-player-section" id="player-container">
        <iframe id="main-player-iframe"
            tabindex="-1"
            src="https://www.youtube-nocookie.com/embed/<%= initial_id %>?autoplay=<%= autoplay_param %>&enablejsapi=1&rel=0&origin=http://localhost:3000"
            title="<%= HTML.escape(initial_title) %>"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen>
        </iframe>
    </div>

    <!-- 2. TOP CARDS COUNTER (Відео знайдено: X / Y) -->
    <div class="top-cards-counter" id="top-cards-counter">
        <span class="cards-count-label">Відео знайдено: <span id="cards-count-num"><b><%= feed_items.size %></b></span></span>
    </div>

    <!-- 3. 3D DRUM CAROUSEL FLOATING OVER PLAYER (CENTERED) -->
    <div class="edge-cards-bar" id="cards-bar-container">
        <!-- 3D Drum Stage: 7 Symmetrical Slots [-3, -2, -1, 0, 1, 2, 3] -->
        <div id="edge-cards-drum" class="cards-drum-stage" tabindex="0"></div>

        <!-- Initial server-rendered cards data -->
        <div id="initial-cards-data" style="display:none;">
            <% feed_items.each do |item| %>
                <%= rendered "components/item" %>
            <% end %>
        </div>
    </div>

    <!-- 4. BOTTOM BAR: Only Song Title and Author -->
    <div class="bottom-now-playing-bar" id="bottom-now-playing-bar">
        <span id="drum-now-playing-title" class="drum-playing-title"></span>
    </div>
</div>

<script src="https://www.youtube.com/iframe_api"></script>
<script src="/js/edge_cinema.js?v=<%= ASSET_COMMIT %>"></script>
<script src="/js/watched_indicator.js"></script>
